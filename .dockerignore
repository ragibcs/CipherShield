# Root build context (all-in-one image only; per-service builds use their
# own directories and .dockerignore files).
.git
.gitignore
**/node_modules
**/.next
**/__pycache__
**/*.pyc
services/api/.venv
services/api/venv
services/api/data
services/api/secrets
services/api/tests
services/api/*.egg-info
.env
.env.*
!.env.example
docs/
scripts/
# eval: keep only the measured summary as baked-in UI evidence.
eval/*
!eval/results/
eval/results/*
!eval/results/summary.json
