# CipherShield AI - example configuration.
# Copy to `.env` and fill in local values. NEVER commit a real `.env`.
# Every value below is a placeholder, not a credential.

APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/ciphershield.db

# --- LLM provider (server-side only; never exposed to the browser) ---
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-name
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# External calls are disabled unless this is explicitly true AND the
# provider configuration validates. Mock provider is used otherwise.
ALLOW_EXTERNAL_LLM=false

# --- Local vault key material (never sent to the LLM) ---
CIPHERSHIELD_KEY_FILE=./secrets/local-master.key

# --- Bounds ---
MAX_INPUT_CHARS=20000
MAX_OUTPUT_TOKENS=1200

# --- Access control for non-localhost deployments ---
# Restore (rehydration) is disabled until an authorization token is set.
VAULT_RESTORE_TOKEN=

# Rate limiting for state-changing endpoints (requests per minute).
RATE_LIMIT_PER_MINUTE=60

# Browser origins allowed to call the API (comma separated).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend build argument: where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
