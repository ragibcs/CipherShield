# syntax=docker/dockerfile:1
# CipherShield AI — production all-in-one image.
#
# One container runs both processes behind a single published port:
#   UI  (Next.js standalone) on $PORT      — default 3000
#   API (FastAPI/uvicorn)   on $API_PORT   — default 8000 (loopback-proxied)
#
# The browser only needs ONE port: Next rewrites /api/* and /health to the
# co-located API (server-side), so no CORS, no NEXT_PUBLIC_API_URL, and no
# second published port are required.
#
#   docker build -t ciphershield .
#   docker run --rm -p 3000:3000 -e CIPHERSHIELD_KEY=<64-hex> ciphershield
#   UI:  http://localhost:3000
#   API: http://localhost:3000/health   (via same-origin proxy)
#
# Production notes:
# - APP_ENV=production by default (OpenAPI docs disabled, static error bodies).
# - External LLM calls are OFF by default; enabling them is an explicit
#   opt-in (ALLOW_EXTERNAL_LLM=true + provider config, key server-side).
# - Vault/audit data lives under /srv/ciphershield/data — mount a volume
#   there for persistence (ephemeral otherwise).
# - Runs as a non-root user; suitable for --read-only with a writable
#   /srv/ciphershield/data mount and --tmpfs /tmp.
# - For the two-service topology (docker-compose.yml / render.yaml) use the
#   per-service images instead: services/api/Dockerfile, apps/web/Dockerfile.

# ---------------------------------------------------------------- web build
FROM node:22-bookworm-slim AS web-builder
WORKDIR /build/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web/ ./
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# --------------------------------------------------------------- api build
FROM python:3.12-slim AS api-builder
WORKDIR /build/api
COPY services/api/pyproject.toml services/api/README.md ./
COPY services/api/app ./app
# Install app + runtime deps (uvicorn, cryptography, ...) into an isolated
# prefix; dev extras (pytest, ruff, mypy) are not part of the image.
RUN pip install --no-cache-dir --prefix=/install .

# ---------------------------------------------------------------- runtime
FROM python:3.12-slim

LABEL org.opencontainers.image.title="CipherShield AI" \
      org.opencontainers.image.description="Local-first secret-isolating AI gateway (API + UI in one container)" \
      org.opencontainers.image.source="https://github.com/ciphershield/ciphershield-ai"

# tini: proper PID 1 signal forwarding + zombie reaping for both children.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    API_PORT=8000 \
    APP_ENV=production \
    ALLOW_EXTERNAL_LLM=false \
    PYTHONPATH=/install/lib/python3.12/site-packages \
    PATH=/install/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Node runtime binary (both images are Debian/glibc; app deps are vendored
# inside .next/standalone by Next.js).
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node

RUN useradd --create-home --uid 10001 ciphershield \
    && mkdir -p /srv/ciphershield/data \
    && chown -R ciphershield:ciphershield /srv/ciphershield
WORKDIR /srv/ciphershield

COPY --from=api-builder --chown=ciphershield:ciphershield /install /install
COPY --chown=ciphershield:ciphershield services/api/app ./app
COPY --from=web-builder --chown=ciphershield:ciphershield /build/web/.next/standalone ./web/
COPY --from=web-builder --chown=ciphershield:ciphershield /build/web/.next/static ./web/.next/static
COPY --from=web-builder --chown=ciphershield:ciphershield /build/web/public ./web/public
# Measured evaluation evidence (generated by scripts/run_security_eval.py,
# committed as eval/results/summary.json) so the Audit & Evaluation screen
# shows real numbers in production too.
COPY --chown=ciphershield:ciphershield eval/results/summary.json ./eval/results/summary.json

# Supervisor: run both processes, exit non-zero if either dies, forward
# SIGTERM/SIGINT so `docker stop` drains both cleanly.
COPY docker/supervise.sh /usr/local/bin/ciphershield-supervise
RUN chmod 0755 /usr/local/bin/ciphershield-supervise

USER ciphershield
EXPOSE 3000 8000
STOPSIGNAL SIGTERM

# Health probes the co-located API (no curl in the slim image; stdlib only).
# If the UI process dies, the supervisor exits the container instead.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import os, urllib.request; p = os.environ.get('API_PORT', '8000'); urllib.request.urlopen(f'http://127.0.0.1:{p}/health', timeout=4)"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/ciphershield-supervise"]
